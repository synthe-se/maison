# The frame's system: Buildroot, every program built for its Cortex-A7. The kernel and the initramfs
# stay frame/linux/build.sh's; this makes the read-only squashfs they start (frame/linux/buildroot.sh).

# Four Cortex-A7 with NEON: all of the system tuned for them
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_VERSION_16_X=y
BR2_OPTIMIZE_2=y
BR2_TIME_BITS_64=y

# systemd, the units of frame/linux/rootfs; root has no password, the frame has no login prompt
BR2_INIT_SYSTEMD=y
# the initramfs mounts a tmpfs over the system: nothing is left to do for / or /var
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_INIT_SYSTEMD_VAR_NONE=y
BR2_TARGET_GENERIC_HOSTNAME="maison-frame"
BR2_TARGET_GENERIC_ISSUE=""
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_TARGET_GENERIC_GETTY_PORT=""
BR2_SYSTEM_DHCP=""
BR2_TARGET_TZ_INFO=y
BR2_TARGET_TZ_ZONELIST="europe"
BR2_TARGET_LOCALTIME="Europe/Paris"
BR2_ROOTFS_OVERLAY="/frame/linux/rootfs"
BR2_ROOTFS_USERS_TABLES="/frame/linux/buildroot/users.table"
BR2_ROOTFS_POST_BUILD_SCRIPT="/frame/linux/buildroot/post-build.sh"
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_PACKAGE_SYSTEMD_ANALYZE=y
# one known board: no table of the world's hardware
# BR2_PACKAGE_SYSTEMD_HWDB is not set
BR2_PACKAGE_LINUX_PAM=y
# what SystemCallFilter= in the units is applied with
BR2_PACKAGE_LIBSECCOMP=y

# The picture: Lima on KMS, cage, what the app's SDL opens at run time
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LIMA=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_LIBXKBCOMMON=y
# xkbcommon's data: SDL and wlroots ask for a context, keyboard or not
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_CAGE=y
BR2_PACKAGE_WLR_RANDR=y

# The Wi-Fi, SSH by key only, a new kernel tried in RAM
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_OPENSSH=y
# BR2_PACKAGE_OPENSSH_CLIENT is not set
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
BR2_PACKAGE_KEXEC=y

# Read-only, zstd: fast to read on the Cortex-A7
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set
