# A frame that lost its network says so, and its own Wi-Fi closes in time
# (usr/local/sbin/maison-wifi-watch).
[Unit]
Description=The frame's network, watched
RequiresMountsFor=/android-data
After=maison-wifi.service wpa_supplicant@wlan0.service

[Service]
ExecStart=/usr/local/sbin/maison-wifi-watch
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
