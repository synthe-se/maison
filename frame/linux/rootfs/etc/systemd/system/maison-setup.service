# The setup's page, started by maison-wifi on the frame's own Wi-Fi (maison-hotspot). It binds the
# access point's address, which comes seconds later: retried without a limit
[Unit]
Description=The frame's setup
RequiresMountsFor=/android-data
After=wpa_supplicant@wlan0.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/maison-setup
Restart=on-failure
RestartSec=2
