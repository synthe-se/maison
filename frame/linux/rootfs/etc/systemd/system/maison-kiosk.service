# Maison on the panel: cog (WPE WebKit) on KMS, turned as the panel is mounted, once the clock is
# right (no RTC: before NTP, TLS fails). The target is Maison's address (install.sh); the frame is
# in as a paired wall screen, by the cookie Maison set, kept with WebKit's storage and cache in
# /android-data/maison/kiosk (the system itself is read-only).
[Unit]
Description=Maison on the panel
RequiresMountsFor=/android-data
Wants=network-online.target systemd-time-wait-sync.service
After=network-online.target time-sync.target systemd-user-sessions.service

[Service]
User=kiosk
ExecStartPre=+/usr/bin/install -d -o kiosk -g kiosk -m 0700 /android-data/maison/kiosk
SupplementaryGroups=video render input
# root's copy of the address (the initramfs adopts what install.sh left, Android's shell-writable
# /data/local/tmp never read here)
LoadCredential=target:/android-data/maison/target
# the frame's language: the page's (maison-kiosk), and the system's locale
Environment=HOME=/home/kiosk XDG_RUNTIME_DIR=/run/kiosk LANG=fr_FR.UTF-8
Environment=XDG_DATA_HOME=/android-data/maison/kiosk/data XDG_CACHE_HOME=/android-data/maison/kiosk/cache
RuntimeDirectory=kiosk
ExecStart=/usr/local/sbin/maison-kiosk
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
