# What every boot proves (usr/local/sbin/maison-commit): not a oneshot, the boot does not wait.
[Unit]
Description=An update proving itself
RequiresMountsFor=/android-data
After=maison-ui.service sshd.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/maison-commit

[Install]
WantedBy=multi-user.target
