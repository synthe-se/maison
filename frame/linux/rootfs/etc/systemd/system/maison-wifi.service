# The networks Android knows (its own wpa_supplicant.conf, in its userdata), handed to ours. Not
# RemainAfterExit: restarting wpa_supplicant@wlan0 runs it again (maison-wifi-watch)
[Unit]
Description=The Wi-Fi networks Android knows
Before=wpa_supplicant@wlan0.service systemd-networkd.service
RequiresMountsFor=/android-data

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/maison-wifi
