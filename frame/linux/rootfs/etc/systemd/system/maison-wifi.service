# The frame's network and address for this boot (usr/local/sbin/maison-wifi). Not RemainAfterExit:
# restarting wpa_supplicant@wlan0 runs it again (maison-hotspot)
[Unit]
Description=The frame's network and address
Before=wpa_supplicant@wlan0.service systemd-networkd.service
RequiresMountsFor=/android-data

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/maison-wifi
