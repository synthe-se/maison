# Maison's native interface (frame/ui): SDL straight on KMS, no compositor, in a logind session on
# tty7 as the kiosk user, no root (its groups open the panel and the touch). It draws upside down,
# as the panel is mounted (MAISON_ROTATE); the device tree maps the touch to what the person sees.
# Maison's address is the credential
# `target`; its cookie is kept 0600 in /android-data/maison/ui; it pairs from its own door.
# It never waits for NTP: after a power cut the clock starts from timesyncd's last one, kept on
# userdata (systemd-timesyncd.service.d/maison.conf), and until the house answers (a clock too
# wrong for TLS among the reasons) the app says so and asks again by itself.
[Unit]
Description=Maison's native interface
Conflicts=getty@tty7.service
RequiresMountsFor=/android-data
Wants=dbus.socket systemd-logind.service maison-wifi.service
# never after the network: the interface shows the house as soon as it can, and retries
After=systemd-user-sessions.service dbus.socket systemd-logind.service maison-wifi.service
ConditionPathExists=/dev/tty0

[Service]
User=kiosk
PAMName=maison-ui
TTYPath=/dev/tty7
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
ExecStartPre=+/usr/bin/install -d -o kiosk -g kiosk -m 0700 /android-data/maison/ui
ExecStartPost=+/usr/bin/chvt 7
# the boot's loader (frame/linux/loader.c) stops where the interface starts; `-`: it may be gone
ExecStartPost=-+/bin/sh -c 'kill $$(pidof maison-loader)'
# root's copy of the address, else the image's (maison-wifi; the initramfs adopts what install.sh
# left, Android's shell-writable /data/local/tmp never read here)
LoadCredential=target:/run/maison-target
EnvironmentFile=-/run/maison-setup
RuntimeDirectory=maison-ui
# what it may reach
NoNewPrivileges=yes
ProtectSystem=strict
# `-`: the first start's ExecStartPre makes it
ReadWritePaths=-/android-data/maison/ui
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
Environment=HOME=/home/kiosk LANG=C.UTF-8 MAISON_STATE=/android-data/maison/ui MAISON_ROTATE=180 MAISON_HEARTBEAT=/run/maison-ui/heartbeat
ExecStart=/usr/local/sbin/maison-ui
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
