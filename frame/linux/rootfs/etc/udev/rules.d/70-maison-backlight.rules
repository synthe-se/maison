# The native app dims the panel while nobody uses the frame (frame/ui backlight.rs): its kiosk
# user, in the video group, may write the backlight's level.
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
