#!/bin/sh
# What wpa_supplicant@wlan0 and the interface read (/etc and /run are tmpfs: rebuilt at every boot,
# never written to the eMMC). The network the frame joined, else the ones Android knows, with only
# the keys both supplicants read the same way; none: wpa_supplicant still runs, for the interface to
# scan (maison-wifid). The address: root's, else the image's default. Only maison-hotspot makes the
# frame its own Wi-Fi for maison-setup: named and locked from its eMMC's serial, what the interface
# shows, the last resort of a dead touch panel.
set -eu
own=/android-data/maison/wifi.conf
android=/android-data/misc/wifi/wpa_supplicant.conf
target=/android-data/maison/target
built=/etc/maison-target
out=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
hotspot=/run/maison-hotspot
umask 077
mkdir -p /etc/wpa_supplicant

# the interface's credential: empty, it says the frame has no address
if [ -s "$target" ]; then
	cat "$target" >/run/maison-target
elif [ -s "$built" ]; then
	cat "$built" >/run/maison-target
else
	: >/run/maison-target
fi

networks() {
	if [ -s "$own" ]; then
		cat "$own"
	elif [ -s "$android" ]; then
		awk '
			/^network=\{/ { inside = 1; print; next }
			inside && /^\}/ { inside = 0; print; next }
			inside {
				key = $0; sub(/^[ \t]*/, "", key); sub(/=.*/, "", key)
				if (key ~ /^(ssid|psk|key_mgmt|priority|scan_ssid|proto|pairwise|group|ieee80211w)$/) print
			}
		' "$android"
	fi
}

if [ ! -e "$hotspot" ]; then
	printf 'ctrl_interface=/run/wpa_supplicant\ncountry=FR\n%s\n' "$(networks)" >"$out"
	echo "maison-wifi: $(grep -c '^network=' "$out" || :) network(s)"
	exit 0
fi

serial=$(sha256sum /sys/block/mmcblk0/device/cid | cut -c1-64)
ssid=Maison-$(echo "$serial" | cut -c1-4)
password=$(echo "$serial" | cut -c5-16)
printf 'ctrl_interface=/run/wpa_supplicant\ncountry=FR\nap_scan=2\nnetwork={\n\tssid="%s"\n\tmode=2\n\tfrequency=2437\n\tkey_mgmt=WPA-PSK\n\tproto=RSN\n\tpairwise=CCMP\n\tgroup=CCMP\n\tpsk="%s"\n}\n' "$ssid" "$password" >"$out"
printf 'MAISON_SETUP_SSID=%s\nMAISON_SETUP_PASSWORD=%s\nMAISON_SETUP_URL=http://192.168.4.1\n' "$ssid" "$password" >/run/maison-setup
chmod 644 /run/maison-setup
# networkd's user reads it, whatever this script's umask
mkdir -p /run/systemd/network
chmod 755 /run/systemd/network
printf '[Match]\nName=wlan0\n\n[Network]\nAddress=192.168.4.1/24\nDHCPServer=yes\n' >/run/systemd/network/40-maison-setup.network
chmod 644 /run/systemd/network/40-maison-setup.network
systemctl --no-block start maison-setup
echo "maison-wifi: its own Wi-Fi, as $ssid"
