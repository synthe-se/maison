#!/bin/sh
# A frame that cannot reach its network says so: 10 minutes without associating, after boot or after
# a lost link, $lost tells the interface (through maison-wifid) to show its Wi-Fi screen, until an
# association. The frame's own Wi-Fi (maison-hotspot, the power key held) is never opened here, only
# closed: 30 minutes after the page's last request (maison-setup touches $setup), the frame returns to
# its network. All of it lives in /run: a restart is a frame as configured. An update on trial stays
# maison-commit's to judge.
set -eu
. /usr/local/lib/maison-slots
step=15
patience=600
open_for=1800
lost=/run/maison-lost
hotspot=/run/maison-hotspot
setup=/run/maison-setup

# `up` only once wpa_supplicant finished the handshake: carrier also rises for a wrong password
associated() { [ "$(cat /sys/class/net/wlan0/operstate 2>/dev/null)" = up ]; }

waited=0 seen=
while :; do
	sleep "$step"
	waited=$((waited + step))
	if [ -e "$hotspot" ]; then
		asked=$(date -r "$setup" +%s 2>/dev/null || echo none)
		[ "$asked" = "$seen" ] || { seen=$asked; waited=0; }
		if [ "$waited" -ge "$open_for" ]; then
			echo "maison-wifi-watch: nothing submitted, back to the configured network"
			maison-hotspot close
			waited=0
		fi
	elif associated || [ -n "$(key pending)" ]; then
		rm -f "$lost"
		waited=0
	elif [ "$waited" -ge "$patience" ] && [ ! -e "$lost" ]; then
		echo "maison-wifi-watch: no network for ${waited}s, the interface says so"
		: >"$lost"
	fi
done
