#!/bin/sh
# Maison's native interface, on the card that has the panel: Lima's is a card too, and which of the
# two comes first is the probe's.
set -eu
for connector in /sys/class/drm/card*-DSI-*; do
	[ -e "$connector" ] || break
	card=${connector#/sys/class/drm/card}
	export SDL_KMSDRM_DEVICE_INDEX="${card%%-*}"
	exec /usr/local/bin/maison-frame-ui
done
echo "no panel on any card" >&2
exit 1
