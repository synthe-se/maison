#!/bin/sh
# What every boot must prove, for 45 s: the interface drawing (its heartbeat fresh), without a
# restart. Then the system counts as good: an update on trial is kept, the active slot's boots go
# back to zero. Else, after 150 s, a restart: the initramfs counts it, and comes back to the slot
# before. A frame still to be set up has nothing to prove.
set -eu
. /usr/local/lib/maison-slots
[ -s "$state" ] || exit 0
[ ! -e /run/maison-setup ] || exit 0

heartbeat=/run/maison-ui/heartbeat
pending=$(key pending)
drawing() {
	[ -e "$heartbeat" ] && [ $(($(date +%s) - $(date -r "$heartbeat" +%s))) -lt 30 ] &&
		[ "$(systemctl show -p NRestarts --value maison-ui)" = 0 ]
}
# an update must be reachable to be kept (a frame that lost the Wi-Fi could never be updated
# again); a system already proved only draws, or a router out of order would turn it into a loop
healthy() {
	drawing || return 1
	[ -z "$pending" ] || { [ "$(systemctl is-active sshd)" = active ] && ip link show wlan0 | grep -q LOWER_UP; }
}

held=0 waited=0
while [ "$waited" -lt 150 ]; do
	if healthy; then held=$((held + 5)); else held=0; fi
	if [ "$held" -ge 45 ]; then
		maison-slot good
		kill "$(pidof maison-guard)" 2>/dev/null || true
		echo "good: slot $(key active)${pending:+, an update kept}"
		exit 0
	fi
	sleep 5
	waited=$((waited + 5))
done
echo "not healthy after ${waited}s: restarting" >&2
systemctl reboot
