# The frame's kernel, merged over multi_v7_defconfig (frame/linux/build.sh).

CONFIG_LOCALVERSION="-maison"

# The CPU supply is not driven (rk3126-amaboo-gbzk-y1000.dts): no frequency above U-Boot's
# CONFIG_CPU_FREQ is not set

# One SoC family: the kernel must end below where U-Boot puts the initramfs (build.sh checks)
# CONFIG_ARCH_VIRT is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_HPE is not set
# CONFIG_ARCH_SUNPLUS is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_AT91 is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_DIGICOLOR is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_HIGHBANK is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_KEYSTONE is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MILBEAUT is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_OMAP is not set
# CONFIG_ARCH_OMAP2PLUS is not set
# CONFIG_ARCH_OMAP3 is not set
# CONFIG_ARCH_OMAP4 is not set
# CONFIG_SOC_OMAP5 is not set
# CONFIG_SOC_AM33XX is not set
# CONFIG_SOC_AM43XX is not set
# CONFIG_SOC_DRA7XX is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SPEAR is not set
# CONFIG_ARCH_STI is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_U8500 is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VT8500 is not set
# CONFIG_ARCH_ZYNQ is not set

# What a photo frame has none of (Ethernet, PCI, raw flash, SATA, network file systems, media),
# and the tracer: the kernel must stay small (build.sh's address check). The network stack stays
# (Wi-Fi). An XZ zImage: the decompressor's own copy past the kernel is smaller too.
# CONFIG_ETHERNET is not set
# CONFIG_PCI is not set
# CONFIG_MTD is not set
# CONFIG_ATA is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_CAN is not set
# CONFIG_FTRACE is not set
CONFIG_KERNEL_XZ=y

# Everything the first boot needs, built in: no modules to find yet
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_KEYBOARD_GPIO=y

# Display: VOP, DSI, its PHY, the panel, the backlight, and the kernel's console on it
CONFIG_DRM=y
# Rockchip's DRM driver (VOP, DSI, its PHY, the panel); simpledrm shows the console until it binds
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
# what the RK3126 has none of
# CONFIG_ROCKCHIP_ANALOGIX_DP is not set
# CONFIG_ROCKCHIP_DW_HDMI is not set
# CONFIG_ROCKCHIP_INNO_HDMI is not set
# CONFIG_ROCKCHIP_LVDS is not set
# CONFIG_ROCKCHIP_CDN_DP is not set
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_JADARD_JD9365DA_H3=y
# bring-up: a driver's debug messages turned on at run time (/sys/kernel/debug/dynamic_debug)
CONFIG_DYNAMIC_DEBUG=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_FBDEV_EMULATION=y
# U-Boot's framebuffer (the device tree's simple-framebuffer): the console before DSI is up
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_LIMA=y

# Wi-Fi: the AIC8800DC on SDIO, its driver out of tree (build.sh) over the kernel's cfg80211
CONFIG_CFG80211=y

# Touch
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SILEAD=y

# The USB-C port as a device: a serial console (CDC ACM) the initramfs sets up
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y

# U-Boot's command line (the vendor's parameter) is kept; ours adds the panel's console, turned
# as the panel is mounted. The vendor's U-Boot leaves its display and eMMC running on clocks and
# power domains mainline would cut as unused: kept. A panic reboots (to Android) after 20 s, a
# sign seen without a console.
# For now one core: bringing up the others after a vendor U-Boot is a classic early hang.
CONFIG_CMDLINE="console=tty0 fbcon=rotate:2 loglevel=8 clk_ignore_unused pd_ignore_unused panic=20 maxcpus=1"
CONFIG_CMDLINE_EXTEND=y
