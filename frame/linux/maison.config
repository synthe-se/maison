# The frame's kernel, all of it: allnoconfig + this file (frame/linux/build.sh). A symbol that is
# not here is not built; a symbol here that kconfig drops fails the build.

CONFIG_LOCALVERSION="-maison"
CONFIG_LOCALVERSION_AUTO=n

# The SoC: four Cortex-A7, r0p5
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HOTPLUG_CPU=y
CONFIG_ARM_ERRATA_814220=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_AEABI=y
CONFIG_ARM_THUMB=y
CONFIG_ARM_UNWIND=y
CONFIG_ARM_PATCH_IDIV=y
CONFIG_ARM_CPU_TOPOLOGY=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
CONFIG_KUSER_HELPERS=y
CONFIG_VDSO=y
CONFIG_COMPAT_32BIT_TIME=y
# ROCKCHIP_PM_DOMAINS depends on what this declares; the SoC has no such firmware
CONFIG_ARM_PSCI=y
# All of the 1 GB in the kernel's direct map: no highmem to map page by page. Build.sh's address
# check reads PAGE_OFFSET from here
CONFIG_VMSPLIT_2G=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_COMPACTION=y

# Nobody at a wall frame's console: whatever breaks restarts it, the log kept on userdata
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y

# A touch screen under one compositor: wakes at once
CONFIG_PREEMPT=y
CONFIG_HZ_250=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_MC=y

# The CPU's clock, never its voltage: nothing drives the rail (the device tree says why)
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPUFREQ_DT=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# Boot: U-Boot's command line (the vendor's parameter) is kept; ours adds what follows. The vendor's
# U-Boot leaves its display and eMMC running on clocks and power domains mainline would cut as
# unused: kept. The touch's firmware
# (3 s of I2C) loads beside the boot, not in it. The law says FR before wpa_supplicant does.
# The eMMC has no partition table mainline reads (the vendor's is mtdparts, for its own kernel):
# userdata, the one partition the system lives on, is declared here (kernel sector = mtdparts
# offset + 8192, checked against layout.txt); the others are not, the command line has 1024 bytes
# and U-Boot's takes about 700.
CONFIG_CMDLINE="console=tty0 clk_ignore_unused pd_ignore_unused driver_async_probe=silead_ts cfg80211.ieee80211_regdom=FR blkdevparts=mmcblk0:-@1423360K(userdata)"
CONFIG_CMDLINE_EXTEND=y
# The fastest to unpack that still fits: the decompressor runs before anything is seen, at 600 MHz
CONFIG_KERNEL_LZO=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# A kernel tried in RAM, the eMMC untouched (try.sh --ram); on SMP kexec is had through SUSPEND
CONFIG_SUSPEND=y
CONFIG_KEXEC=y

# What systemd wants of a kernel
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CONFIGFS_FS=y
CONFIG_UNIX=y
CONFIG_FW_LOADER=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# Hardening that costs next to nothing
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_ARM_PAN=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y

# Reading a failure afterwards: times, symbols, this very config
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_FS=y

# The AIC8800's driver, out of tree (build.sh), its modules in the initramfs
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# The clocks, pins and power of the SoC
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_GRF=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK312X=y
CONFIG_RESET_CONTROLLER=y
CONFIG_MFD_SYSCON=y
CONFIG_SRAM=y
CONFIG_EXTCON=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_RK3X=y

# The eMMC and the system: a squashfs on Android's userdata, a tmpfs over it
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_CMDLINE_PARTITION=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZSTD=y

# The display: VOP, DSI, its PHY, the panel, the backlight, Lima. /dev/fb0 for the initramfs's
# boot picture, no kernel console on it: the boot shows Maison's mark and no text. No simpledrm: a second card is where a client would draw,
# unseen
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_DEVICE=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_JADARD_JD9365DA_H3=y
CONFIG_DRM_LIMA=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# The touch and the power button
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SILEAD=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# The USB-C port as a device: a serial console (CDC ACM) the initramfs sets up
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y

# The network: IPv4, IPv6, Wi-Fi through the kernel's cfg80211. The frame lives on the mains: no
# Wi-Fi power save, which loses multicast (mDNS) and adds latency
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IPV6=y
CONFIG_ETHTOOL_NETLINK=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_DEFAULT_PS=n
