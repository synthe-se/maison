# Host Rust backend
HOST=0.0.0.0
PORT=3033
API_PORT=3033
JWT_SECRET=change-me
FRONTEND_DIST_DIR=web/build
DISABLE_BLUETOOTH=false

# Logging verbosity (uses RUST_LOG syntax)
# Examples: error, warn, info, debug, trace
# Fine-grained: maison_backend=debug,tower_http=info
RUST_LOG=maison_backend=info,tower_http=warn
AUTH_COOKIE_NAME=maison_session
AUTH_COOKIE_SECURE=true
# Where Maison is reached: the passkeys' origin (its host is their RP ID, which never
# changes without losing every passkey). Defaults to https:// + CLOUDFLARE_PUBLIC_HOSTNAME.
# Not for local dev here: deploy.sh pushes .env to the Pi. Locally, in the shell:
#   PUBLIC_URL=http://localhost:5173 make backend
# PUBLIC_URL=https://home.example.com
ZIGBEE_PERMIT_JOIN_SECONDS=120
ZIGBEE_ADAPTER=ember
ZIGBEE_SERIAL_PORT=/dev/serial/by-id/your-sonoff-dongle
ZIGBEE_EZSP_PROTOCOL_VERSION=13
ZIGBEE_LAMPS_JSON_PATH=zigbee-lamps.json
ZIGBEE_LAMPS_BLACKLIST_JSON_PATH=zigbee-lamps-blacklist.json
# Used only when a network is formed: channel 11–26 (default 11), power in dBm (default 8),
# PAN id (decimal or 0x…; unset: the dongle draws one), extended PAN id (16 hex digits; unset:
# from the coordinator's EUI64).
# ZIGBEE_CHANNEL=11
# ZIGBEE_TX_POWER=8
# ZIGBEE_PAN_ID=
# ZIGBEE_EXTENDED_PAN_ID=
CLIMATE_STATE_JSON_PATH=climate-state.json
# Every state file has such a *_JSON_PATH (config.rs), relative to MAISON_SOURCE_ROOT (default:
# the repository's root); the scenes, for one:
# SCENES_JSON_PATH=scenes.json
# The Matter fabric's keys and shutters (a 0700 directory of its own), and the CSA roots.
# MATTER_STATE_DIR=matter
# MATTER_TRUST_DIR=matter-trust
# Development only: accept the CSA test roots (simulators).
# MATTER_TEST_ROOTS=false

# An app's service token over the LAN's plain HTTP (it would cross the Wi-Fi in clear); off by
# default. Tailscale and loopback are always allowed.
ALLOW_LAN_TOKENS=false
# A wall screen not seen for this many days is revoked (0: never).
SCREEN_IDLE_DAYS=90
# Where the CLI adds its security events (invite, token create/revoke): the service's log.
# MAISON_LOG_FILE=/var/log/maison.log

# Optional Cloudflare tunnel token: deploy.sh writes it to /etc/cloudflared-maison/token on the
# Pi (0600, cloudflared's own user) and leaves it out of the Pi's .env.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_PROTOCOL=http2

# Optional stable public URL for documentation/status output
# Example: maison.example.com
CLOUDFLARE_PUBLIC_HOSTNAME=

# SSH target for deploy.sh / make deploy-* targets
PI_HOST=root@192.168.1.103
NABAZTAG_HOST=

# Machine token for the STB IR bridge (kird), 32 characters at least (shorter: the backend
# refuses to start; `openssl rand -hex 32`). Empty/unset = IR API disabled.
IR_API_TOKEN=

# Tempo (backend/src/tempo/): RTE's public open data needs no key. With a free account on
# data.rte-france.com (application « Tempo Like Supply Contract »), RTE's official API is
# asked first. The other sources (api-couleur-tempo, EDF, data.gouv, ODRE, Open-Meteo) need
# nothing; their URLs (TEMPO_RTE_URL, TEMPO_RTE_API_URL, TEMPO_FALLBACK_URL, TEMPO_EDF_URL,
# TEMPO_TARIFS_URL, TEMPO_ODRE_URL, OPEN_METEO_URL) only change for tests.
RTE_CLIENT_ID=
RTE_CLIENT_SECRET=
# Where the Tempo cache lives (seasons, model.json, netload.json, weather.json).
# TEMPO_CACHE_DIR=cache/tempo
# The place search for the sun schedule (Open-Meteo's geocoding); only changes for tests.
# GEOCODING_URL=https://geocoding-api.open-meteo.com
