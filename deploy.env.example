# This house's deploy settings, sourced by deploy.sh (bash), never pushed: cp deploy.env.example deploy.env

# SSH target, by key
DEPLOY_HOST=root@maison.example

# What the host runs. A target rustup ships, built with cargo-zigbuild:
BACKEND_TARGET=aarch64-unknown-linux-musl
# A Raspberry Pi 1 or Zero: BACKEND_TARGET=arm-unknown-linux-musleabihf, and
# export RUSTFLAGS="-C target-cpu=arm1176jzf-s"

# Or a build of its own (a target rustup does not ship) and the binary it makes:
# BACKEND_BUILD='make -C ../box-image maison MAISON_DIR="$PWD"'
# BACKEND_BIN="${ROOT_DIR}/../box-image/build_output/maison-backend"

# With EDGE_LISTEN in .env: the host's certificates (`maison-backend edge init`'s first directory)
# EDGE_HOUSE_DIR="$HOME/maison-edge/house"
