#!/sbin/openrc-run

# The Cloudflare tunnel, under a user of its own (not the backend's): a cloudflared compromised
# reads neither .env (JWT_SECRET) nor auth/ nor matter/. Its token lives in its own 0600 file,
# which deploy.sh writes from the Mac's .env (CLOUDFLARE_TUNNEL_TOKEN) and leaves out of the
# Pi's .env; it reaches cloudflared in its environment, never on a command line.

name="cloudflared-maison"
description="maison Cloudflare Tunnel"
token_file="/etc/cloudflared-maison/token"
pidfile="/run/${RC_SVCNAME}.pid"
logfile="/var/log/cloudflared-maison.log"
service_user="@@TUNNEL_USER@@"
# http2 (default) or quic, from /etc/conf.d/cloudflared-maison (deploy.sh writes it)
cloudflared_protocol="${cloudflared_protocol:-http2}"

depend() {
	need net
	use dns logger maison
}

start_pre() {
	checkpath -f -m 0640 -o "${service_user}:${service_user}" "${logfile}"
	if ! command -v cloudflared >/dev/null 2>&1; then
		eerror "cloudflared is not installed"
		return 1
	fi
	if [ ! -s "${token_file}" ]; then
		eerror "Missing tunnel token: ${token_file} (deploy.sh push writes it)"
		return 1
	fi
}

start() {
	ebegin "Starting ${RC_SVCNAME}"
	start-stop-daemon --start --background --make-pidfile --pidfile "${pidfile}" \
		--user "${service_user}" --group "${service_user}" --chdir / \
		--stdout "${logfile}" --stderr "${logfile}" \
		--exec /bin/sh -- -c 'TUNNEL_TOKEN="$(cat "'"${token_file}"'")"; export TUNNEL_TOKEN; exec cloudflared tunnel --no-autoupdate --protocol "'"${cloudflared_protocol}"'" run'
	eend $?
}

stop() {
	ebegin "Stopping ${RC_SVCNAME}"
	start-stop-daemon --stop --pidfile "${pidfile}" --retry TERM/30/KILL/5
	eend $?
}
