# Log rotation for the maison stack (installed to /etc/logrotate.d/maison,
# run by Alpine's /etc/periodic/daily via crond).
# The services write through shell redirection and cannot reopen their log
# on signal, hence copytruncate. Two weeks kept (the security events: sign-ins,
# refusals, tokens made or revoked), compressed, at the logs' own 0640: an incident
# noticed a week late can still be read. A copy off the Pi (remote syslog) is the
# owner's option: docs/deploy.md.
/var/log/maison.log
/var/log/cloudflared-maison.log
/var/log/clapier.log
/var/log/mosquitto/mosquitto.log
{
    daily
    rotate 14
    maxsize 20M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
